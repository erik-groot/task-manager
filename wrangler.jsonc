{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "task-manager",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Verify Access before serving HTML, assets, or API requests.
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "task-manager-db",
    // Replace with the UUID returned by: npx wrangler d1 create task-manager-db
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }]
  // Set ACCESS_TEAM_DOMAIN, ACCESS_AUD, ACCESS_ALLOWED_EMAILS as Worker secrets.
  // There is no production authentication bypass.
}
